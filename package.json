{
  "name": "pi-posttrain-loop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pi Agent loop for post-training dataset synthesis, blind CoT reasoning backfill, and adversarial probe evaluation backed by SQLite.",
  "license": "MIT",
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "dm": "node --env-file-if-exists=.env --import tsx src/cli/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.6.0",
    "@earendil-works/pi-ai": "1.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
