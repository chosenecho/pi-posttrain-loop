# OpenAI Chat Completions compatible TEXT model with streaming enabled.
# Set the API root, not /chat/completions. Local routing group example:
LLM_BASE_URL=http://127.0.0.1:3425/v1
LLM_MODEL=auto/deepseek-v4.1-flash
LLM_API_KEY=replace-with-your-key

# Defaults: high reasoning and 1M context. Check the selected model's actual limits.
# reasoning_effort requires a compatible reasoning model and gateway.
LLM_THINKING_LEVEL=high
# Optional per-role thinking level overrides (inherit LLM_THINKING_LEVEL when omitted):
# LLM_QUESTION_THINKING_LEVEL=high
# LLM_ANSWER_THINKING_LEVEL=high
# LLM_JUDGE_THINKING_LEVEL=low
# LLM_FOLLOWUP_THINKING_LEVEL=medium
# LLM_RUBRIC_THINKING_LEVEL=medium
LLM_CONTEXT_WINDOW=1048576
LLM_MAX_TOKENS=65536
LLM_TIMEOUT_MS=180000

# Credential inheritance is bound to the normalized API root (scheme/host/port/path).
# Same API root: role keys may be omitted. Different root: set a dedicated key or EMPTY.
# Explicit blank candidate keys and EMPTY omit Authorization; Pi clients use EMPTY as a placeholder.
# Non-secret model/thinking/timeout defaults still inherit independently.
# Optional: independent CoT backfill writer/judge overrides for `npm run reasoning`
# (useful for plugging in a local Qwen3.8-27B endpoint):
# REASONING_BASE_URL=http://127.0.0.1:8000/v1
# REASONING_MODEL=Qwen3.8-27B
# REASONING_API_KEY=replace-with-your-key
# REASONING_THINKING_LEVEL=medium
# REASONING_JUDGE_BASE_URL=http://127.0.0.1:3425/v1
# REASONING_JUDGE_MODEL=auto/deepseek-v4.1-flash
# REASONING_JUDGE_API_KEY=replace-with-your-key
# REASONING_JUDGE_THINKING_LEVEL=low

# Optional: independent Probe Eval generator/grader overrides for `npm run eval`
# (keys inherit only when the API root is unchanged):
# EVAL_LLM_BASE_URL=http://127.0.0.1:3425/v1
# EVAL_LLM_MODEL=auto/deepseek-v4.1-flash
# EVAL_LLM_API_KEY=replace-with-your-key

# Optional: default candidate model endpoint for `npm run eval -- run`
# (can also be passed via --base-url / --model / --api-key CLI flags):
# CANDIDATE_LLM_BASE_URL=http://127.0.0.1:8000/v1
# CANDIDATE_LLM_MODEL=sft-v1
# CANDIDATE_LLM_API_KEY=EMPTY
# CANDIDATE_LLM_MAX_TOKENS=2048
# CANDIDATE_LLM_TIMEOUT_MS=90000
# Optional: override default candidate system prompt (defaults to prompts/eval/candidate-system.md; pass --no-system-prompt to omit):
# CANDIDATE_LLM_SYSTEM_PROMPT=
# CANDIDATE_LLM_SYSTEM_PROMPT_FILE=prompts/eval/candidate-system.md
